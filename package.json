{
  "name": "judovacapp",
  "version": "1.0.0",
  "description": "Gestion professionnelle des enregistrements judokas — Offline / LAN",
  "main": "./out/main/index.js",
  "author": "JudoVACapp",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "dev:vercel": "vercel dev",
    "dev:win": "dev.bat",
    "build": "electron-vite build",
    "build:web": "vite build",
    "preview": "electron-vite preview",
    "preview:web": "vite preview",
    "dist": "npm run icon:build && npm run build && electron-builder --win --x64",
    "dist:dir": "npm run icon:build && npm run build && electron-builder --win --x64 --dir",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test:sync": "tsx --tsconfig tsconfig.node.json scripts/test-sync.ts",
    "lint": "tsc --noEmit -p tsconfig.web.json",
    "admin:create": "tsx --tsconfig tsconfig.node.json scripts/create-admin.ts",
    "admin:diagnose": "tsx --tsconfig tsconfig.node.json scripts/diagnose-supabase.ts",
    "icon:build": "tsx --tsconfig tsconfig.node.json scripts/build-icon.ts",
    "build:apk:scanner": "powershell -ExecutionPolicy Bypass -File mobile/scripts/build-apk.ps1",
    "build:apk:mobile": "powershell -ExecutionPolicy Bypass -File mobile-app/scripts/build-apk.ps1"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@supabase/supabase-js": "^2.49.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.1.8",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
